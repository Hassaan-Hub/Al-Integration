    },
    {
      "name": "AI task planning (provider may be unavailable)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Plan the steps to prepare a short project demonstration.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/ai/plan-task",
        "description": "Requires Groq configuration and available quota. The test accepts either a valid plan or a recognized configuration/provider error; it does not assume the AI call will succeed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a successful plan or a recognized provider/configuration error', function () {",
              "  pm.expect([200, 429, 500, 502, 503]).to.include(pm.response.code);",
              "  const body = pm.response.json();",
              "  if (pm.response.code === 200) {",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.plan.summary).to.be.a('string').and.not.empty;",
              "    pm.expect(['low', 'medium', 'high']).to.include(body.plan.priority);",
              "    pm.expect(body.plan.estimatedHours).to.be.a('number').and.above(0);",
              "    pm.expect(body.plan.steps).to.be.an('array').that.is.not.empty;",
              "    body.plan.steps.forEach(function (step) {",
              "      pm.expect(step).to.be.a('string').and.not.empty;",
              "    });",
              "  } else {",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.message).to.be.a('string').and.not.empty;",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ],
