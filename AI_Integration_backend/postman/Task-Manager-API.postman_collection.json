            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Invalid status validation test\",\n  \"status\": \"blocked\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks",
        "description": "Validation-only request; should be rejected without creating a task."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Explains the allowed statuses', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.include('pending');",
              "  pm.expect(body.message).to.include('in-progress');",
              "  pm.expect(body.message).to.include('completed');",
              "});"
            ]
          }
        }
      ]
    },
