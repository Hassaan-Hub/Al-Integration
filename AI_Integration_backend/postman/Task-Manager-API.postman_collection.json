          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/ai/plan-task",
        "description": "Validation-only request; it should return 400 without calling Groq."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns HTTP 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Reports the required description', function () {",
              "  const body = pm.response.json();",
